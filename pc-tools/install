#!/bin/bash
# Make the batocera-* helpers available as commands on this PC (links in ~/.local/bin).
here=$(dirname "$(readlink -f "$0")")
mkdir -p ~/.local/bin
for tool in "$here"/batocera-*; do
    ln -sfn "$tool" ~/.local/bin/"$(basename "$tool")"
    echo "linked $(basename "$tool")"
done
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "Add ~/.local/bin to your PATH to use them." ;; esac
