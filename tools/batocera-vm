#!/bin/bash
# Boot the Batocera USB stick in a window on this PC (a virtual machine), without restarting.
#
#   batocera-vm            test mode: nothing is written to the stick; changes vanish when you close it,
#                          and the access it opens (stick, controllers) is taken back
#   batocera-vm --write    changes made inside (settings, saves, scraped art) are kept on the stick
#
# Game controllers connected to this PC are handed to Batocera while it runs, also ones that
# connect after it has started (BATOCERA_VM_PADS=no keeps them here).
# It is for checking menus, settings and that games show up. Games run slowly here because the
# virtual machine has no real graphics card; use reboot-to-batocera to actually play.
# It opens full screen: Ctrl+Alt+Q closes it, Ctrl+Alt+G releases the mouse. Do not switch between
# full screen and a window while it runs (Ctrl+Alt+F): Batocera's menus do not follow the change.
# BATOCERA_VM_WINDOW=1 starts it in a window instead.
set -euo pipefail

MODE=test
case "${1:-}" in
    --write) MODE=write ;;
    ""|--test) ;;
    *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

die() { echo "batocera-vm: $1" >&2; exit 1; }

part=$(lsblk -rno PATH,LABEL | awk '$2 == "BATOCERA" { print $1; exit }')
[ -n "$part" ] || die "No partition labelled BATOCERA found. Is the stick plugged in?"
disk="/dev/$(lsblk -no PKNAME "$part" | head -n1)"
[ "$(lsblk -dno RM "$disk")" = "1" ] || die "$disk is not a removable drive; refusing to use it."

run=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/batocera-vm.XXXXXX")
# Batocera's kernel is started directly (copied off the stick first), which is the way this was tested.
bootmp=$(lsblk -no MOUNTPOINT "$part" | head -n1)
if [ -z "$bootmp" ]; then udisksctl mount -b "$part" >/dev/null || die "Could not mount $part."; bootmp=$(lsblk -no MOUNTPOINT "$part" | head -n1); fi
cp "$bootmp/boot/linux" "$bootmp/boot/initrd.gz" "$run/" || die "Could not read Batocera's kernel from $bootmp/boot."

# The stick must not be in use by this PC while Batocera runs from it.
mounted=()
while read -r p mp; do
    [ -n "$mp" ] || continue
    udisksctl unmount -b "$p" >/dev/null || die "Could not unmount $p ($mp). Close anything using the stick."
    mounted+=("$p")
done < <(lsblk -rno PATH,MOUNTPOINT "$disk" | tail -n +2)

need=r; [ "$MODE" = write ] && need=rw
want_pads=yes; [ "${BATOCERA_VM_PADS:-yes}" = no ] && want_pads=no

# One request for your password covers both things that need it: reading the stick directly, and
# handing game controllers to Batocera. A controller gets a new device file each time it connects
# (a Bluetooth one every time it wakes), so a small helper stays on for as long as the virtual
# machine runs and opens each one to you as it appears. It ends when the window closes.
touch "$run/alive"
if [ "$want_pads" = yes ] || ! { [ -r "$disk" ] && { [ "$MODE" = test ] || [ -w "$disk" ]; }; }; then
    echo "Asking for your password: to read the stick, and to hand controllers to Batocera as they connect..."
    pkexec /bin/bash -c '
        user=$1 disk=$2 need=$3 alive=$4 pads=$5
        /usr/bin/setfacl -m "u:$user:$need" "$disk" || exit 1
        opened=""
        while [ -e "$alive" ]; do
            if [ "$pads" = yes ]; then
                for event in $(awk "BEGIN { RS = \"\" } /Handlers=[^\n]*js[0-9]/ { if (match(\$0, /event[0-9]+/)) print substr(\$0, RSTART, RLENGTH) }" /proc/bus/input/devices); do
                    [ -e "/dev/input/$event" ] && /usr/bin/setfacl -m "u:$user:rw" "/dev/input/$event" 2>/dev/null &&
                        case " $opened " in *" $event "*) ;; *) opened="$opened $event" ;; esac
                done
            fi
            sleep 1
        done
        # The window has closed: take back everything opened to you above, so nothing is left behind.
        /usr/bin/setfacl -x "u:$user" "$disk" 2>/dev/null
        for event in $opened; do [ -e "/dev/input/$event" ] && /usr/bin/setfacl -x "u:$user" "/dev/input/$event" 2>/dev/null; done
        exit 0' batocera-vm "$(id -un)" "$disk" "$need" "$run/alive" "$want_pads" &
    for _ in $(seq 600); do   # until the password has been given and the stick can be read
        { [ -r "$disk" ] && { [ "$MODE" = test ] || [ -w "$disk" ]; }; } && break
        kill -0 $! 2>/dev/null || break
        sleep 0.1
    done
    { [ -r "$disk" ] && { [ "$MODE" = test ] || [ -w "$disk" ]; }; } || die "Could not get access to $disk."
fi

# Game controllers connected to this PC (USB or Bluetooth) are handed to Batocera for as long as
# the virtual machine runs, including ones that connect, or wake up, after it has started: it sees
# the same controller, and this PC does not until you close the window. Each sits in one of a few
# spare slots the virtual machine is given, so it can be put in and taken out while it runs.
pad_args=()
if [ "$want_pads" = yes ]; then
    for n in 0 1 2 3; do pad_args+=(-device "pcie-root-port,id=padslot$n,chassis=$((n + 20)),slot=$((n + 20))"); done
    pad_args+=(-qmp "unix:$run/qmp,server,nowait")
    python3 - "$run" <<'WATCH' &
import json, os, re, socket, sys, time
run = sys.argv[1]

def pads():
    """The event device of every game controller this PC has now."""
    found = []
    try:
        for block in open("/proc/bus/input/devices").read().split("\n\n"):
            if re.search(r"Handlers=.*\bjs\d", block):
                event = re.search(r"event\d+", block)
                if event and os.path.exists(f"/dev/input/{event.group()}"):
                    found.append(f"/dev/input/{event.group()}")
    except OSError:
        pass
    return found

def ask(command, **arguments):
    """One word to the virtual machine; its answer, or None when it has gone."""
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(3)
            s.connect(f"{run}/qmp")
            reader = s.makefile()
            reader.readline()
            for message in ({"execute": "qmp_capabilities"}, {"execute": command, "arguments": arguments}):
                s.sendall(json.dumps(message).encode())
                while True:
                    reply = json.loads(reader.readline())
                    if "return" in reply or "error" in reply:
                        break
            return reply
    except (OSError, ValueError):
        return None

handed, count = {}, 0          # device file -> (its name in the virtual machine, its slot)
while os.path.exists(f"{run}/alive"):
    now = pads()
    for path in [p for p in handed if p not in now]:      # switched off or unplugged
        ask("device_del", id=handed.pop(path)[0])
    for path in now:
        free = [n for n in range(4) if n not in {slot for _name, slot in handed.values()}]
        if path in handed or not free or not os.access(path, os.R_OK | os.W_OK):
            continue
        count += 1
        reply = ask("device_add", driver="virtio-input-host-pci", evdev=path, id=f"pad{count}", bus=f"padslot{free[0]}")
        if reply and "return" in reply:
            handed[path] = (f"pad{count}", free[0])
            print(f"Controller handed to Batocera: {path}", flush=True)
    time.sleep(1)
WATCH
    echo "Controllers are handed to Batocera as they connect, and come back to this PC when the window closes."
fi

cleanup() {
    rm -rf "$run"   # this also tells the two helpers above to stop (and the root one to take back its access)
    rm -f "${shell:-}"
    for p in "${mounted[@]}"; do udisksctl mount -b "$p" >/dev/null 2>&1 || true; done
}
trap cleanup EXIT

snap=on
if [ "$MODE" = write ]; then snap=off; echo "WRITE mode: changes are saved to the stick."
else echo "Test mode: nothing is written to the stick."; fi

# Full screen from the start. Batocera's menus measure the screen once, when they start; changing
# the window's size afterwards (going full screen later, dragging a corner) changes the screen
# under them and leaves them cut off or unresponsive. A real TV never does that. For a window
# instead: BATOCERA_VM_WINDOW=1 batocera-vm, and leave its size alone while it runs.
full=on; [ -n "${BATOCERA_VM_WINDOW:-}" ] && full=off

# For looking into a running session when something misbehaves: Batocera's console is on a
# socket only you can reach (socat - UNIX-CONNECT:<that path> gives its shell).
shell="${XDG_RUNTIME_DIR:-/tmp}/batocera-vm.shell"
rm -f "$shell"

cpus=$(( $(nproc) / 2 )); [ "$cpus" -gt 6 ] && cpus=6; [ "$cpus" -lt 2 ] && cpus=2

# Batocera's menu needs accelerated graphics, so the virtual screen uses this PC's GPU (virgl).
# WLR_NO_HARDWARE_CURSORS (handed to Batocera's compositor through the kernel's command line) has
# it draw the mouse pointer itself: the virtual screen's own pointer comes out upside down and
# offset from where it really is.
# Sound: 80 ms of buffer on this PC's side. The virtual machine draws everything without a real
# graphics card and its sound card is an emulated one, so sound here can stutter when the screen
# is busy; that says nothing about the real thing. More buffer rides out more of it at the price
# of sounds trailing the picture (BATOCERA_VM_AUDIO_US=200000); less does the opposite (=25000).
# The phone keyboard (on-screen keyboard > PHONE) serves its page on ports 8377-8386. The virtual
# machine's network is private to this PC, so those ports are passed on from this PC, and Batocera is
# told this PC's address (emubox.phonehost=) to put in the QR code: a phone on the same network can
# then reach it. Without a network address here the phone keyboard says it cannot be reached.
host_ip=$(ip -4 route get 192.0.2.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
phone_fwd=""
for port in $(seq 8377 8386); do phone_fwd+=",hostfwd=tcp::$port-:$port"; done

# BATOCERA_VM_DISPLAY and BATOCERA_VM_EXTRA are for troubleshooting, e.g.
#   BATOCERA_VM_DISPLAY=sdl,gl=on batocera-vm
qemu-system-x86_64 \
    -name "Batocera ($MODE mode)" -machine q35,accel=kvm -cpu host -smp "$cpus" -m 6G \
    -kernel "$run/linux" -initrd "$run/initrd.gz" \
    -append "label=BATOCERA console=tty3 console=ttyS0 quiet loglevel=0 vt.global_cursor_default=0 WLR_NO_HARDWARE_CURSORS=1${host_ip:+ emubox.phonehost=$host_ip}" \
    -serial "unix:$shell,server,nowait" \
    -drive file="$disk",format=raw,if=none,id=stick,snapshot=$snap,cache=writeback \
    -device ich9-ahci,id=ahci -device ide-hd,drive=stick,bus=ahci.0 \
    -device qemu-xhci -device usb-kbd -device usb-tablet "${pad_args[@]}" \
    -nic "user,model=e1000e$phone_fwd" \
    -audiodev "pipewire,id=snd,out.latency=${BATOCERA_VM_AUDIO_US:-80000},timer-period=5000" \
    -device ich9-intel-hda -device hda-duplex,audiodev=snd \
    -device virtio-vga-gl -vga none -display "${BATOCERA_VM_DISPLAY:-gtk,gl=on,zoom-to-fit=on,full-screen=$full}" \
    ${BATOCERA_VM_EXTRA:-}
