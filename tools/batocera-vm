#!/bin/bash
# Boot the Batocera USB stick in a window on this PC (a virtual machine), without restarting.
#
#   batocera-vm            test mode: nothing is written to the stick; changes vanish when you close it
#   batocera-vm --write    changes made inside (settings, saves, scraped art) are kept on the stick
#
# A game controller connected to this PC is handed to Batocera while it runs (BATOCERA_VM_PADS=no
# keeps it here).
# It is for checking menus, settings and that games show up. Games run slowly here because the
# virtual machine has no real graphics card; use reboot-to-batocera to actually play.
# Keys: Ctrl+Alt+G releases the mouse, Ctrl+Alt+F toggles fullscreen. Close the window to stop.
set -euo pipefail

MODE=test
case "${1:-}" in
    --write) MODE=write ;;
    ""|--test) ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

die() { echo "batocera-vm: $1" >&2; exit 1; }

part=$(lsblk -rno PATH,LABEL | awk '$2 == "BATOCERA" { print $1; exit }')
[ -n "$part" ] || die "No partition labelled BATOCERA found. Is the stick plugged in?"
disk="/dev/$(lsblk -no PKNAME "$part" | head -n1)"
[ "$(lsblk -dno RM "$disk")" = "1" ] || die "$disk is not a removable drive; refusing to use it."

run=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/batocera-vm.XXXXXX")
# Batocera's kernel is started directly (copied off the stick first), which is the way this was tested.
bootmp=$(lsblk -no MOUNTPOINT "$part" | head -n1)
if [ -z "$bootmp" ]; then udisksctl mount -b "$part" >/dev/null || die "Could not mount $part."; bootmp=$(lsblk -no MOUNTPOINT "$part" | head -n1); fi
cp "$bootmp/boot/linux" "$bootmp/boot/initrd.gz" "$run/" || die "Could not read Batocera's kernel from $bootmp/boot."

# The stick must not be in use by this PC while Batocera runs from it.
mounted=()
while read -r p mp; do
    [ -n "$mp" ] || continue
    udisksctl unmount -b "$p" >/dev/null || die "Could not unmount $p ($mp). Close anything using the stick."
    mounted+=("$p")
done < <(lsblk -rno PATH,MOUNTPOINT "$disk" | tail -n +2)

need=r; [ "$MODE" = write ] && need=rw
if ! { [ -r "$disk" ] && { [ "$MODE" = test ] || [ -w "$disk" ]; }; }; then
    echo "Asking for your password to let this session read the stick directly..."
    pkexec /usr/bin/setfacl -m "u:$(id -un):$need" "$disk" || die "Could not get access to $disk."
fi

# Game controllers connected to this PC (USB or Bluetooth) are handed to Batocera for as long as
# the virtual machine runs: it sees the same controller, and this PC does not until you close it.
pads=()
if [ "${BATOCERA_VM_PADS:-yes}" != no ]; then
    while read -r event; do
        [ -e "/dev/input/$event" ] && pads+=("/dev/input/$event")
    done < <(awk 'BEGIN { RS = "" } /Handlers=[^\n]*js[0-9]/ { if (match($0, /event[0-9]+/)) print substr($0, RSTART, RLENGTH) }' /proc/bus/input/devices)
fi
pad_args=()
for pad in "${pads[@]}"; do
    if ! { [ -r "$pad" ] && [ -w "$pad" ]; }; then
        echo "Asking for your password to hand the controller ($pad) to Batocera..."
        pkexec /usr/bin/setfacl -m "u:$(id -un):rw" "${pads[@]}" || { echo "No access to the controller; starting without it."; pads=(); break; }
    fi
done
for pad in "${pads[@]}"; do pad_args+=(-device "virtio-input-host-pci,evdev=$pad"); done
[ "${#pads[@]}" -gt 0 ] && echo "Controller(s) handed to Batocera: ${#pads[@]}. They come back to this PC when the window closes."

cleanup() {
    rm -rf "$run"
    for p in "${mounted[@]}"; do udisksctl mount -b "$p" >/dev/null 2>&1 || true; done
}
trap cleanup EXIT

snap=on
if [ "$MODE" = write ]; then snap=off; echo "WRITE mode: changes are saved to the stick."
else echo "Test mode: nothing is written to the stick."; fi

cpus=$(( $(nproc) / 2 )); [ "$cpus" -gt 6 ] && cpus=6; [ "$cpus" -lt 2 ] && cpus=2

# Batocera's menu needs accelerated graphics, so the virtual screen uses this PC's GPU (virgl).
# WLR_NO_HARDWARE_CURSORS (handed to Batocera's compositor through the kernel's command line) has
# it draw the mouse pointer itself: the virtual screen's own pointer comes out upside down and
# offset from where it really is.
# BATOCERA_VM_DISPLAY and BATOCERA_VM_EXTRA are for troubleshooting, e.g.
#   BATOCERA_VM_DISPLAY=sdl,gl=on batocera-vm
qemu-system-x86_64 \
    -name "Batocera ($MODE mode)" -machine q35,accel=kvm -cpu host -smp "$cpus" -m 6G \
    -kernel "$run/linux" -initrd "$run/initrd.gz" \
    -append "label=BATOCERA console=tty3 quiet loglevel=0 vt.global_cursor_default=0 WLR_NO_HARDWARE_CURSORS=1" \
    -drive file="$disk",format=raw,if=none,id=stick,snapshot=$snap,cache=writeback \
    -device ich9-ahci,id=ahci -device ide-hd,drive=stick,bus=ahci.0 \
    -device qemu-xhci -device usb-kbd -device usb-tablet "${pad_args[@]}" \
    -nic user,model=e1000e \
    -audiodev pipewire,id=snd -device ich9-intel-hda -device hda-duplex,audiodev=snd \
    -device virtio-vga-gl -vga none -display "${BATOCERA_VM_DISPLAY:-gtk,gl=on,zoom-to-fit=on}" \
    ${BATOCERA_VM_EXTRA:-}
