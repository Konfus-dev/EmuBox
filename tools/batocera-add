#!/usr/bin/env python3
"""Copy games (and ROM-hack patches) onto the Batocera USB stick, into the right folders.

  batocera-add game.sfc other.gba            pick the console from the file type
  batocera-add -s psx "My Game.chd"          say which console (needed for .zip/.iso/.chd/.bin...)
  batocera-add ~/Downloads/snes-games/       a whole folder
  batocera-add hack.bps                      a patch: goes to patches/ and is applied now
  batocera-add --list                        show console folder names
"""
import argparse, getpass, os, re, shutil, subprocess, sys

PATCH_EXTS = (".ips", ".bps", ".ups")
# File types that mean one console in practice even though several folders accept them.
PREFER = {".sfc": "snes", ".smc": "snes", ".nes": "nes", ".gb": "gb", ".gbc": "gbc", ".gba": "gba",
          ".md": "megadrive", ".gen": "megadrive", ".sms": "mastersystem", ".gg": "gamegear",
          ".n64": "n64", ".z64": "n64", ".v64": "n64", ".nds": "nds", ".3ds": "3ds", ".pce": "pcengine",
          ".wbfs": "wii", ".cso": "psp", ".32x": "sega32x", ".a26": "atari2600", ".lnx": "lynx",
          ".ws": "wswan", ".wsc": "wswanc", ".ngp": "ngp", ".ngc": "ngpc", ".vb": "virtualboy",
          ".fds": "fds", ".sg": "sg1000", ".col": "colecovision", ".d64": "c64", ".p8": "pico8"}


def find_drive(arg):
    if arg:
        return arg
    path = "/run/media/%s/SHARE" % getpass.getuser()
    if not os.path.isdir(os.path.join(path, "roms")) and os.path.exists("/dev/disk/by-label/SHARE"):
        subprocess.run(["udisksctl", "mount", "-b", "/dev/disk/by-label/SHARE"], capture_output=True)
    if not os.path.isdir(os.path.join(path, "roms")):
        sys.exit("Can't find the Batocera stick. Plug it in (or pass --drive /path/to/SHARE).")
    return path


def ext_map(roms):
    m = {}
    for system in sorted(os.listdir(roms)):
        info = os.path.join(roms, system, "_info.txt")
        if not os.path.isfile(info):
            continue
        with open(info, errors="replace") as f:
            found = re.search(r'extensions accepted: "([^"]*)"', f.read())
        for e in (found.group(1).split() if found else []):
            m.setdefault(e.lower(), []).append(system)
    return m


def pick_system(path, forced, exts):
    if forced:
        return forced, None
    e = os.path.splitext(path)[1].lower()
    if e in PREFER:
        return PREFER[e], None
    cands = exts.get(e, [])
    if len(cands) == 1:
        return cands[0], None
    if not cands:
        return None, "no console accepts '%s' files" % e
    shown = ", ".join(cands[:12]) + (", ..." if len(cands) > 12 else "")
    return None, "'%s' files fit several consoles (%s) - add  -s <console>" % (e, shown)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="*", help="game files, folders, or patch files")
    ap.add_argument("-s", "--system", help="console folder name, e.g. snes, psx, ps2 (see --list)")
    ap.add_argument("--drive", help="path to the mounted SHARE partition")
    ap.add_argument("--list", action="store_true", help="list console folder names")
    ap.add_argument("--force", action="store_true", help="overwrite games already on the stick")
    a = ap.parse_args()
    drive = find_drive(a.drive)
    roms = os.path.join(drive, "roms")
    systems = sorted(d for d in os.listdir(roms) if os.path.isdir(os.path.join(roms, d)))
    if a.list:
        print("  ".join(systems))
        return 0
    if not a.paths:
        ap.print_help()
        return 1
    if a.system and a.system not in systems:
        sys.exit("No console folder called '%s'. Run: batocera-add --list" % a.system)
    exts = ext_map(roms)

    files = []
    for p in a.paths:
        if os.path.isdir(p) and not a.system:
            for root, _, names in os.walk(p):
                files += [os.path.join(root, n) for n in sorted(names)]
        elif os.path.exists(p):
            files.append(p)       # with -s, a folder is copied whole (multi-file games)
        else:
            print("SKIP  %s: not found" % p)
    added = skipped = patches = 0
    for f in files:
        name = os.path.basename(os.path.normpath(f))
        if name.lower().endswith(PATCH_EXTS) and not a.system:
            os.makedirs(os.path.join(drive, "patches"), exist_ok=True)
            shutil.copy2(f, os.path.join(drive, "patches", name))
            patches += 1
            continue
        system, why = pick_system(f, a.system, exts)
        if not system:
            print("SKIP  %s: %s" % (name, why))
            skipped += 1
            continue
        dest = os.path.join(roms, system, name)
        if os.path.exists(dest) and not a.force:
            print("SKIP  %s: already in roms/%s (use --force to replace)" % (name, system))
            skipped += 1
            continue
        size = sum(os.path.getsize(os.path.join(r, n)) for r, _, ns in os.walk(f) for n in ns) \
            if os.path.isdir(f) else os.path.getsize(f)
        if size > shutil.disk_usage(drive).free - 64 * 2**20:
            print("SKIP  %s: not enough free space on the stick" % name)
            skipped += 1
            continue
        try:
            if os.path.isdir(f):
                shutil.copytree(f, dest, dirs_exist_ok=True)
            else:
                shutil.copy2(f, dest)
        except PermissionError:
            sys.exit("No permission to write to %s" % os.path.dirname(dest))
        print("ADDED %s -> roms/%s" % (name, system))
        added += 1
    if patches or added:
        tool = os.path.join(drive, "system", "retrobox", "tools", "apply-patches.py")
        if os.path.isfile(tool) and os.path.isdir(os.path.join(drive, "patches")):
            subprocess.run([sys.executable, tool, drive])
    os.sync()
    free = shutil.disk_usage(drive).free / 2**30
    print("\n%d added, %d skipped, %d patch file(s) queued. %.1f GB free on the stick." % (added, skipped, patches, free))
    if added or patches:
        print("In Batocera: Start > Game settings > Update gamelists (or just reboot it).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
