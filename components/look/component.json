{
  "title": "Xbox-style look",
  "question": "Install the Xbox-style look (green theme, start-up film, menu colours, fonts and sounds)?",
  "default": true,
  "order": 10,
  "files": [
    {
      "from": "files/theme",
      "to": "themes/emubox"
    },
    {
      "from": "files/controlcenter/style.css",
      "to": "system/configs/controlcenter/style.css"
    },
    {
      "from": "files/fonts",
      "to": "system/.fonts"
    },
    {
      "from": "files/splash",
      "to": "splash"
    },
    {
      "from": "files/splash/emubox.mp4",
      "to": "system/emubox/splash/emubox.mp4"
    }
  ],
  "es_settings": {
    "ThemeSet": "emubox",
    "EnableSounds": true,
    "SplashScreen": false,
    "SplashScreenProgress": false
  },
  "replaces": [
    "themes/classic-dash",
    "themes/emubox/omen-lights"
  ],
  "after": "The look is selected as the theme. To switch back: Main menu > User interface settings > Theme set."
}
