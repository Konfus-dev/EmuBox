  <!-- ===================== always on screen: one row along the top =====================
       Far left, a light per controller. On the right: how full the drive is (space.xml), the clock,
       then Batocera's network and battery icons. Everything is centred on the same line (y = 0.037). -->
  <view name="screen">
    <!-- One small controller per connected pad: light green at rest, dark green while a button is held. -->
    <controllerActivity name="controllerActivity">
      <pos>0.014 0.022</pos>
      <size>0.30 0.03</size>
      <horizontalAlignment>left</horizontalAlignment>
      <itemSpacing>0.004</itemSpacing>
      <imagePath>${themePath}/art/gamepad.png</imagePath>
      <gunPath>${themePath}/art/gamepad.png</gunPath>
      <wheelPath>${themePath}/art/gamepad.png</wheelPath>
      <color>c8f03cff</color>
      <activityColor>2f7d1eff</activityColor>
      <hotkeyColor>2f7d1eff</hotkeyColor>
    </controllerActivity>
    <text name="clock">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.026</fontSize>
      <color>${colText}</color>
      <pos>0.862 0.012</pos>
      <size>0.088 0.05</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
    </text>
    <batteryIndicator name="batteryIndicator">
      <pos>0.957 0.023</pos>
      <size>0.03 0.028</size>
      <horizontalAlignment>right</horizontalAlignment>
      <color>d6f9b8ff</color>
    </batteryIndicator>
  </view>

  <!-- ===================== pop-up menus ===================== -->
  <view name="menu">
    <!-- A pane of dark glass with clipped corners and a lit edge; the screen behind shows through. -->
    <menuBackground name="menubg">
      <path>${themePath}/art/frame.png</path>
      <color>ffffff</color>
      <cornerSize>44 44</cornerSize>
      <fadeMs>220</fadeMs>
      <scrollbarColor>c8f03c90</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>innerright</scrollbarAlignment>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${colBright}</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>${fontTitle}</fontPath>
      <fontSize>0.014</fontSize>
      <color>${colTextDim}</color>
    </menuText>
    <!-- Rows: the chosen one is a bar of light, brightest along its top edge. -->
    <menuText name="menutext">
      <fontPath>${fontTextBold}</fontPath>
      <fontSize>0.029</fontSize>
      <color>${colText}</color>
      <separatorColor>96f55030</separatorColor>
      <selectorColor>f0ff8c</selectorColor>
      <selectorColorEnd>9adc20</selectorColorEnd>
