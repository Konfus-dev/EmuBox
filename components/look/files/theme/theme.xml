      <iconLeftRight>${themePath}/art/help/xk_leftright.png</iconLeftRight>
      <iconUpDownLeftRight>${themePath}/art/help/xk_all.png</iconUpDownLeftRight>
    </helpsystem>
  </view>

  <!-- ===================== menu sounds =====================
       Made by components/look/tools/sounds.py. Batocera 43's menu program only plays the scroll
       sound (the scrollSound of each list and carousel), and what it plays is scroll-now.wav: a copy
       of the chosen sound set's scroll sound at the chosen volume, redrawn by lib/menusounds.py.
       That tool also plays select.wav, back.wav and menuopen.wav itself, straight from art/sounds. -->
  <view name="system, basic, detailed, video, grid, gamecarousel, menu, screen">
    <sound name="scroll">
      <path>${themePath}/art/sounds/scroll.wav</path>
    </sound>
    <sound name="systembrowse">
      <path>${themePath}/art/sounds/scroll.wav</path>
    </sound>
    <sound name="quicksysselect">
      <path>${themePath}/art/sounds/scroll.wav</path>
    </sound>
    <sound name="select">
      <path>${themePath}/art/sounds/select.wav</path>
    </sound>
    <sound name="favorite">
      <path>${themePath}/art/sounds/select.wav</path>
    </sound>
    <sound name="back">
      <path>${themePath}/art/sounds/back.wav</path>
    </sound>
    <sound name="menuOpen">
      <path>${themePath}/art/sounds/menuopen.wav</path>
    </sound>
    <sound name="launch">
      <path>${themePath}/art/sounds/launch.wav</path>
    </sound>
  </view>

