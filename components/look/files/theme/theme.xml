    <helpsystem name="help">
      <pos>0.5 0.948</pos>
      <origin>0.5 0</origin>
      <fontPath>${fontTextBold}</fontPath>
      <fontSize>0.025</fontSize>
      <textColor>${colText}</textColor>
      <iconColor>ffffff</iconColor>
      <!-- Batocera's "b" is the bottom face button (Xbox A), "a" the right (Xbox B), "x" the top (Xbox Y), "y" the left (Xbox X) -->
      <iconB>${themePath}/art/help/xk_confirm_b.png</iconB>
      <iconA>${themePath}/art/help/xk_back_a.png</iconA>
      <iconX>${themePath}/art/help/xk_top_x.png</iconX>
      <iconY>${themePath}/art/help/xk_left_y.png</iconY>
      <iconStart>${themePath}/art/help/xk_start.png</iconStart>
      <iconSelect>${themePath}/art/help/xk_select.png</iconSelect>
      <iconL>${themePath}/art/help/xk_l.png</iconL>
