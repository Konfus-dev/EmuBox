<?xml version="1.0" encoding="UTF-8"?>
<!--
Theme: EmuBox
A green "glowing orb and angular panels" dashboard look for Batocera.
All artwork is original and generated by art.py; fonts are Michroma and Rajdhani (SIL Open Font License, see art/fonts).
System logos and console pictures are borrowed at run time from Batocera's built-in Carbon theme;
art/logos and art/badges hold EmuBox's own for systems that theme does not know (the Store, Apps).
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>
  <!-- How full the drive is, in the top row left of the clock; redrawn on Batocera by lib/space.py. -->
  <include>./space.xml</include>
  <variables>
    <fontTitle>${themePath}/art/fonts/Michroma-Regular.ttf</fontTitle>
    <fontText>${themePath}/art/fonts/Rajdhani-Medium.ttf</fontText>
    <fontTextBold>${themePath}/art/fonts/Rajdhani-SemiBold.ttf</fontTextBold>
    <colText>d6f9b8</colText>
    <colTextDim>8fc878</colTextDim>
    <colBright>c8f03c</colBright>
    <colOnBright>0a2a00</colOnBright>
    <colBar>0b470be6</colBar>
    <carbonLogos>/usr/share/emulationstation/themes/es-theme-carbon/art/logos</carbonLogos>
    <carbonConsoles>/usr/share/emulationstation/themes/es-theme-carbon/art/consoles</carbonConsoles>
  </variables>

  <!-- ===================== shared by every screen ===================== -->
  <view name="system, basic, detailed, video, grid">
    <image name="helpStrip" extra="static">
      <path>${themePath}/art/white.png</path>
      <color>00140000</color>
      <colorEnd>001400d0</colorEnd>
      <gradientType>vertical</gradientType>
      <pos>0 0.9</pos>
      <origin>0 0</origin>
      <size>1 0.1</size>
      <zIndex>60</zIndex>
    </image>
    <image name="holoScanlines" extra="static">
      <path>${themePath}/art/scanlines.png</path>
      <tile>true</tile>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>90</zIndex>
    </image>
    <image name="holoRollBand" extra="static">
      <path>${themePath}/art/rollband.png</path>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 0.3</size>
      <zIndex>91</zIndex>
      <storyboard>
        <animation property="y" from="-0.3" to="1" duration="7000" mode="linear" repeat="forever"/>
      </storyboard>
    </image>
    <image name="holoFlickerA" extra="static">
      <path>${themePath}/art/white.png</path>
      <color>001000</color>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>92</zIndex>
      <opacity>0</opacity>
      <storyboard>
        <animation property="opacity" from="0" to="0.07" duration="130" mode="easeinout" repeat="forever" autoReverse="true"/>
      </storyboard>
    </image>
    <image name="holoFlickerB" extra="static">
      <path>${themePath}/art/white.png</path>
      <color>001000</color>
      <pos>0 0</pos>
      <origin>0 0</origin>
