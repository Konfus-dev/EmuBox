#!/bin/bash
# EmuBox drive guard keeper. Batocera's updates delete files they did not ship from /boot, among
# them /boot/boot-custom.sh, which keeps Batocera's storage manager away from the PC's own disks.
# At every start this puts that file back when it is missing or older than EmuBox's copy, and
# unmounts any of the PC's own partitions that were mounted while it was missing.
[ "$1" = "start" ] || exit 0
SRC=/userdata/system/emubox/boot/boot-custom.sh
DST=/boot/boot-custom.sh
LOG=/userdata/system/logs/emubox.log
say() { echo "$(date '+%F %T') bootguard: $*" >> "$LOG"; }

if [ -f "$SRC" ] && ! cmp -s "$SRC" "$DST"; then
    if mount -o remount,rw /boot; then
        cp "$SRC" "$DST" && sync && say "put /boot/boot-custom.sh back (missing or out of date)"
        mount -o remount,ro /boot
        bash "$DST" start    # guard drives that appear from now on
    else
        say "could not write /boot to put boot-custom.sh back"
    fi
fi

# EmuBox's start-up picture (from the look), which /boot/boot-custom.sh shows instead of
# Batocera's logo. It has to be on /boot: the games partition is not there yet when it is shown.
LOGO=/userdata/system/emubox/boot/boot-logo.png
if [ -f "$LOGO" ] && ! cmp -s "$LOGO" /boot/emubox-boot-logo.png; then
    if mount -o remount,rw /boot; then
        cp "$LOGO" /boot/emubox-boot-logo.png && sync && say "put EmuBox's start-up picture on /boot"
        mount -o remount,ro /boot
    fi
fi

# Anything mounted under /media from a disk that is not on USB came from the PC's own disks
# (Windows, another Linux) while the guard was missing: let go of it.
for mp in /media/*; do
    src=$(findmnt -rno SOURCE --mountpoint "$mp" 2>/dev/null | head -n1)   # empty: not a mount point
    case "$src" in /dev/*) ;; *) continue ;; esac
    disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
    [ -n "$disk" ] || disk=${src#/dev/}
    case "$(readlink -f "/sys/block/$disk")" in */usb*) continue ;; esac
    if umount "$mp"; then
        rmdir "$mp" 2>/dev/null
        say "unmounted $src from $mp (the PC's own disk)"
    fi
done

# --- the data partition's label (added 2026-11-19) ---
# Renamed from SHARE (it happened once), Batocera took the data partition for a second drive: it
# merged /userdata over it, moved every game into /userdata/.roms_base and wrote mergerfs.roms= into
# batocera-boot.conf, and the menus showed no games. Nothing is moved or renamed here (putting it
# back is for a person to do, with the games in mind); it is said as loudly as a log can.
ROMS_BASE=/userdata/.roms_base
BOOT_CONF=/boot/batocera-boot.conf
if [ -e "$ROMS_BASE" ] || grep -q '^[[:space:]]*mergerfs\.roms=' "$BOOT_CONF" 2>/dev/null; then
    for line in "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" \
                "WARNING: Batocera has merged its games folder (/userdata/.roms_base or mergerfs.roms= in $BOOT_CONF)." \
                "The data partition was probably renamed: its label must be SHARE. Games may be out of sight, not lost." \
                "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"; do
        say "$line"
        echo "$(date '+%F %T') $line" >> /var/log/emubox-boot.log
    done
fi
exit 0
