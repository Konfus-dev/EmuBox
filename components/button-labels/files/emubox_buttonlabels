#!/bin/bash
# EmuBox: Xbox button labels in the standalone Nintendo emulators (labels.py says how and why).
# Shows up under Main menu > System Settings > Services; Batocera calls it with "start" at boot.
case "$1" in
    start) python3 /userdata/system/emubox/button-labels/labels.py >/dev/null 2>&1 ;;
esac
exit 0
