{
  "title": "Console tools",
  "hidden": true,
  "changes_es_settings": true,
  "files": [
    {
      "from": "files/bin",
      "to": "system/emubox/bin",
      "mode": "755"
    },
    {
      "from": "files/lib",
      "to": "system/emubox/lib"
    },
    {
      "from": "files/services/emubox",
      "to": "system/services/emubox",
      "mode": "755"
    },
    {
      "from": "files/hotkeygen/common_context.conf",
      "to": "system/configs/hotkeygen/common_context.conf"
    },
    {
      "from": "files/hotkeygen/default_mapping.conf",
      "to": "system/configs/hotkeygen/default_mapping.conf"
    },
    {
      "from": "files/es_systems_apps.cfg",
      "to": "system/configs/emulationstation/es_systems_apps.cfg"
    },
    {
      "from": "files/es-scripts/emubox-screensaver.sh",
      "to": "system/configs/emulationstation/scripts/screensaver-start/emubox-screensaver.sh",
      "mode": "755"
    },
    {
      "from": "files/es-scripts/emubox-screensaver.sh",
      "to": "system/configs/emulationstation/scripts/screensaver-stop/emubox-screensaver.sh",
      "mode": "755"
    }
  ],
  "services": [
    "emubox"
  ],
  "replaces": [
    "system/console-apps",
    "system/services/console_apps",
    "roms/ports/Install Discord and Apple Music.sh",
    "roms/ports/EmuBox Settings.sh",
    "system/emubox/lib/menu.py"
  ],
  "retired_services": [
    "console_apps"
  ],
  "renamed_from": [
    "runtime"
  ],
  "generated": [
    {
      "path": "system/configs/controlcenter/controlcenter.xml",
      "contains": "<!-- emubox apps -->"
    },
    {
      "path": "system/configs/emulationstation/es_features_emubox.cfg",
      "contains": "written by EmuBox"
    }
  ]
}
