#!/bin/bash
# Open, hide and control EmuBox apps (Discord, Apple Music...) on Batocera.
#
#   emubox-app open <app> [--wait]   start it, or bring it back if it is running
#   emubox-app detach <command...>   run any of these in the background and return at once
#                                    (the in-game menu stops a button's command after 3 seconds)
#   emubox-app mic in-use|muted|mute|unmute   the microphone, for a quick mute during a call
#   emubox-app back [<app>]          hide it and return to the game (it keeps running)
#   emubox-app close <app>           quit it
#   emubox-app install <app>         download it (needs internet); "open" does this when needed
#   emubox-app fetch <name> <flatpak id>   download any Flathub program behind the same notice
#   emubox-app running <app>         exit status 0 if it is running
#   emubox-app play <app>            play/pause; opens the app first when it is not running
#   emubox-app media PlayPause|Next|Previous|title|playing
#   emubox-app status music|call     a line for the Guide menu's app bars (empty when idle)
#   emubox-app power next|previous   step the processor's power mode
#   emubox-app music line|toggle|next|previous   the menus' own background music (lib/music.py)
#   emubox-app setting [is|get|set <name> [value]]   EmuBox's switches (see lib/settings.py)
#   emubox-app pads                  note the connected controllers in the log (for troubleshooting)
#   emubox-app list                  the apps that are set up
#
# Each app is one folder, apps/<app>/, whose app.json says what to start, how
# its window is named, and what the controller's buttons do in it.

ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
RUN=/var/run/emubox
LOG=/userdata/system/logs/emubox.log
mkdir -p "$RUN" "$(dirname "$LOG")"

# Batocera's display, for when we are called from a menu with a bare environment.
export HOME=/userdata/system XDG_RUNTIME_DIR=/var/run
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" DISPLAY="${DISPLAY:-:0}"
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=labwc:wlroots

# The apps need a D-Bus session of their own (Batocera has none): flatpak's
# sandbox helper lives on it, and so do the players' media controls.
BUS="unix:path=$RUN/bus"
export DBUS_SESSION_BUS_ADDRESS="$BUS"
bus_call() { dbus-send --bus="$BUS" --print-reply "$@" 2>/dev/null; }
start_bus() {
    bus_call --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId >/dev/null && return
    rm -f "$RUN/bus"
    dbus-daemon --session --address="$BUS" --fork --nopidfile 2>>"$LOG"
}

conf() { jq -r "$2" "$ROOT/apps/$1/app.json"; }
list_apps() { for f in "$ROOT"/apps/*/app.json; do [ -f "$f" ] && basename "$(dirname "$f")"; done; }
need_app() {
    [ -f "$ROOT/apps/$1/app.json" ] && return
    echo "emubox-app: no such app '$1' (have: $(list_apps | tr '\n' ' '))" >&2
    exit 2
}

# The app's window, as the compositor names it (empty when there is none).
window() {
    wlrctl toplevel list 2>/dev/null | awk -F': ' -v p="$(conf "$1" .window)" 'index($1, p) == 1 { print $1; exit }'
}
focused() { local w; w=$(window "$1"); [ -n "$w" ] && wlrctl toplevel find "app_id:$w" state:focused 2>/dev/null; }
running() { [ -e "$RUN/$1.started" ] && flatpak ps --columns=application 2>/dev/null | grep -qx "$(conf "$1" .flatpak)"; }
installed() { flatpak info "$(conf "$1" .flatpak)" >/dev/null 2>&1; }

# download <name> <flatpak id>
download() {
    local name=$1 flatpak=$2 free_gb
    free_gb=$(df -BG --output=avail /userdata | tail -1 | tr -dc 0-9)
    if [ "${free_gb:-0}" -lt 3 ]; then echo "Not enough free space for $name (${free_gb} GB free, 3 GB needed)."; return 1; fi
    echo "Getting ready..."
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || return 1
    # One download at a time: a second request waits here, then finds the first one's work done.
    flock "$RUN/download.lock" flatpak install -y --noninteractive flathub "$flatpak" || return 1
    # Same permission fix Batocera applies after installing a flatpak.
    chmod -R a+rX /userdata/saves/flatpak/binaries
    chmod a+rx /userdata /userdata/saves /userdata/saves/flatpak
    echo "$name is ready."
}
# Download behind a full-screen notice (B cancels), so the screen never looks frozen.
fetch() {
    local name=$1 flatpak=$2
    flatpak info "$flatpak" >/dev/null 2>&1 && return
    python3 "$ROOT/lib/notice.py" "Downloading $name" -- "$0" download "$name" "$flatpak" 2>>"$LOG"
    case $? in
    0 | 1 | 130) ;;   # done, failed (the notice said so), or cancelled with B
    *)                # the notice itself could not be shown: fall back to a plain terminal
        if command -v xterm >/dev/null; then
            xterm -fullscreen -fa Monospace -fs 14 -e bash -c "'$0' download '$name' '$flatpak' 2>&1 | tee -a '$LOG'; sleep 4"
        else
            "$0" download "$name" "$flatpak" >>"$LOG" 2>&1
        fi ;;
    esac
    flatpak info "$flatpak" >/dev/null 2>&1
}
install_app() { fetch "$(conf "$1" .name)" "$(conf "$1" .flatpak)"; }

start_pad() {
    # An app that understands controllers itself (a game launcher) gets them untouched.
    [ "$(conf "$1" '.pad // empty')" ] || return 0
    local pidfile="$RUN/$1.pad.pid"
    [ -e "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null && return
    setsid python3 "$ROOT/lib/pad.py" "$ROOT/apps/$1/app.json" >>"$LOG" 2>&1 &
    echo $! >"$pidfile"
}

open_app() {
    local app=$1 w
    start_bus
    w=$(window "$app")
    if [ -z "$w" ]; then
        install_app "$app" || { echo "emubox-app: $(conf "$app" .name) could not be downloaded; see $LOG" >&2; return 1; }
        # Sound for the sandboxed app (the same fix Batocera applies to its own flatpaks).
        chown -R root:audio /var/run/pulse 2>/dev/null; chmod -R g+rwX /var/run/pulse 2>/dev/null
        mapfile -t args < <(conf "$app" '.args[]')
        echo "$(date '+%F %T') starting $app" >>"$LOG"
        setsid flatpak run "$(conf "$app" .flatpak)" "${args[@]}" >>"$LOG" 2>&1 &
        touch "$RUN/$app.started"
        for _ in $(seq 240); do   # up to a minute: first starts download updates
            w=$(window "$app"); [ -n "$w" ] && break
            sleep 0.25
        done
        [ -n "$w" ] || { echo "emubox-app: $app did not open a window; see $LOG" >&2; return 1; }
        wlrctl toplevel fullscreen "app_id:$w"
    fi
    wlrctl toplevel focus "app_id:$w"
    start_pad "$app"
}

# Used when the app is started like a game from the menu: come back when the
# player leaves the app (hides or quits it), so the menu returns.
wait_until_left() {
    local away=0
    sleep 2
    while [ "$away" -lt 3 ]; do
        sleep 0.5
        if focused "$1" >/dev/null; then away=0; else away=$((away + 1)); fi
    done
}

back() {
    local app w
    for app in ${1:-$(list_apps)}; do
        w=$(window "$app"); [ -n "$w" ] && wlrctl toplevel minimize "app_id:$w"
    done
}

# The microphone as a whole, so it works whichever window is in front. "in-use" prints
# something while an app is recording (in a call); "muted" prints true while it is off.
mic() {
    case $1 in
    in-use)  # nobody listening any more: never leave the microphone off behind a finished call
        if pactl list short source-outputs 2>/dev/null | grep -q .; then echo yes
        elif [ -e "$RUN/mic.muted" ]; then mic unmute; fi ;;
    muted)   pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -q yes && echo true ;;
    mute)    pactl set-source-mute @DEFAULT_SOURCE@ 1 && touch "$RUN/mic.muted" ;;
    unmute)  pactl set-source-mute @DEFAULT_SOURCE@ 0; rm -f "$RUN/mic.muted" ;;
    *) echo "emubox-app mic in-use|muted|mute|unmute" >&2; exit 2 ;;
    esac
}

close_app() {
    [ -e "$RUN/mic.muted" ] && mic unmute
    flatpak kill "$(conf "$1" .flatpak)" 2>/dev/null
    rm -f "$RUN/$1.started"
    [ -e "$RUN/$1.pad.pid" ] && kill "$(cat "$RUN/$1.pad.pid")" 2>/dev/null
    rm -f "$RUN/$1.pad.pid"
}

players() {
    bus_call --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ListNames |
        grep -o 'org\.mpris\.MediaPlayer2\.[^"]*'
}
media() {
    local p
    case $1 in
    PlayPause | Next | Previous | Pause | Play)
        for p in $(players); do
            bus_call --dest="$p" /org/mpris/MediaPlayer2 "org.mpris.MediaPlayer2.Player.$1" >/dev/null
        done ;;
    title)  # "Song by Artist" of whatever is playing, or nothing
        for p in $(players); do
            bus_call --dest="$p" /org/mpris/MediaPlayer2 org.freedesktop.DBus.Properties.Get \
                string:org.mpris.MediaPlayer2.Player string:Metadata |
                awk -F'"' '/xesam:title/ { want = "t" } /xesam:artist/ { want = "a" }
                           /string "/ && !/xesam:|mpris:/ { if (want == "t" && !t) t = $2; if (want == "a" && !a) a = $2; want = "" }
                           END { if (t) print t (a ? " by " a : "") }'
        done | head -n 1 ;;
    sounding)  # prints "yes" while music is actually coming out (not paused, not stopped)
        for p in $(players); do
            bus_call --dest="$p" /org/mpris/MediaPlayer2 org.freedesktop.DBus.Properties.Get \
                string:org.mpris.MediaPlayer2.Player string:PlaybackStatus | grep -q '"Playing"' && { echo yes; break; }
        done ;;
    silent)  # the opposite: prints "yes" when nothing is coming out
        [ -z "$(media sounding)" ] && echo yes ;;
    playing)  # the same, for showing on screen: never empty
        local title; title=$(media title)
        echo "${title:-Nothing playing}" ;;
    *) echo "emubox-app media PlayPause|Next|Previous|title|playing|sounding|silent" >&2; exit 2 ;;
    esac
}

# The processor's power mode, stepped through from the Guide menu.
power() {
    local modes=(highperformance balanced powersaver) at
    at=$(cat "$RUN/power" 2>/dev/null); at=${at:-1}
    case $1 in next) at=$(( (at + 1) % 3 )) ;; previous) at=$(( (at + 2) % 3 )) ;; *) echo "emubox-app power next|previous" >&2; exit 2 ;; esac
    echo "$at" >"$RUN/power"
    batocera-power-mode "${modes[$at]}" >/dev/null 2>&1
}

# One line for the Guide menu's app bars: nothing when there is nothing to say.
status() {
    case $1 in
    music) local title; title=$(media title)   # kept short: a long line would push the menu off the screen
           [ "${#title}" -gt 34 ] && title="${title:0:32}..."
           [ -n "$title" ] && { [ -n "$(media sounding)" ] && echo "Playing: $title" || echo "Paused: $title"; } ;;
    call)  if pactl list short source-outputs 2>/dev/null | grep -q .; then
               pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -q yes && echo "In a call - microphone muted" || echo "In a call"
           fi ;;
    *) echo "emubox-app status music|call" >&2; exit 2 ;;
    esac
}

# The menu's quick Play: carry on with the paused song; with no song yet, open the app
# so there is something to play.
play() {
    if [ -n "$(players)" ]; then media Play; else open_app "$1"; fi
}

# Which controllers are connected, and what Batocera's menu calls their buttons.
pads() {
    {
        echo "$(date '+%F %T') controllers:"
        python3 - <<'PY'
import evdev
for path in evdev.list_devices():
    d = evdev.InputDevice(path)
    keys = d.capabilities().get(evdev.ecodes.EV_KEY, [])
    if evdev.ecodes.BTN_SOUTH in keys:
        i = d.info
        print(f"  {d.name!r} bus={i.bustype:04x} vendor={i.vendor:04x} product={i.product:04x} "
              f"version={i.version:04x} phys={d.phys} keys={sorted(keys)}")
PY
        grep -h -B1 -A3 'inputConfig' /userdata/system/configs/emulationstation/es_input.cfg 2>/dev/null | head -60
        tail -n 5 /userdata/system/configs/emulationstation/es_last_input.cfg 2>/dev/null
    } >>"$LOG" 2>&1
}

case $1 in
detach)   shift; setsid "$0" "$@" </dev/null >/dev/null 2>&1 & ;;
mic)      mic "$2" ;;
setting)  shift; exec python3 "$ROOT/lib/settings.py" "$@" ;;
status)   status "$2" ;;
power)    power "$2" ;;
music)    shift; exec python3 "$ROOT/lib/music.py" "$@" ;;
open)     need_app "$2"; open_app "$2" || exit 1; if [ "$3" = --wait ]; then wait_until_left "$2"; fi ;;
back)     [ -n "$2" ] && need_app "$2"; back "$2" ;;
close)    need_app "$2"; close_app "$2" ;;
install)  need_app "$2"; install_app "$2" ;;
fetch)    fetch "$2" "$3" ;;
download) download "$2" "$3" ;;
running)  need_app "$2"; running "$2" ;;
media)    media "$2" ;;
play)     need_app "$2"; play "$2" ;;
pads)     pads ;;
list)     list_apps ;;
*)        sed -n '2,21s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
