#!/bin/bash
# EmuBox for Batocera. Shows up as a switch under
#   Main menu > System Settings > Services
# and runs EmuBox's helpers: the Guide menu, menu sounds, the audio rules, the Start-menu entries.
#
# Batocera calls this with "start" or "stop".

root=/userdata/system/emubox

case "$1" in
    start)
        # Rebuilt at every boot from Batocera's own menu, so it follows updates.
        # The menu program reads its layout once, when it starts; if it is
        # already running and the layout changed, start it afresh (hidden).
        python3 "$root/lib/space.py" --theme 2>/dev/null   # the "how full is the drive" indicator in the menus
        python3 "$root/lib/startmenu.py" 2>/dev/null       # EmuBox's settings in Start > Game Settings
        # Menus go quiet under your music, music makes way for a call (lib/audio.py).
        mkdir -p /var/run/emubox
        if ! kill -0 "$(cat /var/run/emubox/audio.pid 2>/dev/null)" 2>/dev/null; then
            setsid python3 "$root/lib/audio.py" >>/userdata/system/logs/emubox.log 2>&1 &
            echo $! >/var/run/emubox/audio.pid
        fi
        # Menu sounds: the chosen set and volume, and the select, back and menu sounds Batocera's menus lack.
        if ! kill -0 "$(cat /var/run/emubox/menusounds.pid 2>/dev/null)" 2>/dev/null; then
            setsid python3 "$root/lib/menusounds.py" >>/userdata/system/logs/emubox.log 2>&1 &
            echo $! >/var/run/emubox/menusounds.pid
        fi
        # EmuBox's own Guide menu, waiting hidden for the Guide button (lib/guide.py).
        if ! kill -0 "$(cat /var/run/emubox/guide.pid 2>/dev/null)" 2>/dev/null; then
            ( [ -r /etc/profile.d/xdg.sh ] && . /etc/profile.d/xdg.sh
              export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
              setsid python3 "$root/lib/guide.py" >>/userdata/system/logs/emubox.log 2>&1 </dev/null & )
        fi
        # Earlier versions added a tab to Batocera's own quick menu: take that file away again.
        old=/userdata/system/configs/controlcenter/controlcenter.xml
        grep -q "emubox apps" "$old" 2>/dev/null && rm -f "$old"
        # A note of the connected controllers, a little after start-up when
        # wireless ones have had time to connect. Helps explain odd buttons.
        (sleep 60; "$root/bin/emubox-app" pads) >/dev/null 2>&1 &
        ;;
    stop)
        kill "$(cat /var/run/emubox/audio.pid 2>/dev/null)" 2>/dev/null; rm -f /var/run/emubox/audio.pid
        kill "$(cat /var/run/emubox/menusounds.pid 2>/dev/null)" 2>/dev/null; rm -f /var/run/emubox/menusounds.pid
        kill "$(cat /var/run/emubox/guide.pid 2>/dev/null)" 2>/dev/null
        # The Apps tab stays in place: Batocera also calls "stop" at shutdown,
        # and its menu may start before we do at the next boot.
        for app in $("$root/bin/emubox-app" list); do "$root/bin/emubox-app" close "$app"; done
        python3 "$root/lib/space.py" --theme 2>/dev/null   # so the indicator is right at the next start
        python3 "$root/lib/startmenu.py" 2>/dev/null       # and new sound sets are offered
        ;;
esac
